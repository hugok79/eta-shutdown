project('eta-shutdown')

subdir('po')
# install sources
install_subdir('src', install_dir : '/usr/share/eta/eta-shutdown')
install_subdir('ui', install_dir : '/usr/share/eta/eta-shutdown')
install_data('data/eta-shutdown.systemd', install_dir : '/lib/systemd/system/',rename: 'eta-shutdown.service')
install_data('data/config.ini', install_dir : '/etc/pardus',rename: 'eta-shutdown.conf')
install_data('data/tr.org.pardus.eta.shutdown.desktop', install_dir : '/usr/share/applications/')
install_data('data/eta-poweroff-menu.desktop', install_dir : '/usr/share/applications/')
install_data('data/eta-poweroff-add.desktop', install_dir : '/etc/xdg/autostart')
install_data('data/tr.org.pardus.eta.shutdown.policy', install_dir : '/usr/share/polkit-1/actions/')
install_data('eta-shutdown', install_dir : '/usr/bin', install_mode: ['rwxr-xr-x'])
install_data('eta-poweroff-add-to-desktop', install_dir : '/usr/libexec', install_mode: ['rwxr-xr-x'])
install_data('data/eta-shutdown.svg', install_dir : '/usr/share/icons/hicolor/scalable/apps')
install_subdir('data/icons', install_dir : '/usr/share/icons/hicolor/scalable/actions',  strip_directory: true)
